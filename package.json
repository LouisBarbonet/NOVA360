{
  "name": "LotoQuebec360",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "extract": "tsx scripts/extract.ts",
    "validate": "tsx scripts/validate.ts",
    "test": "vitest run",
    "export": "npm run build && tsx scripts/export.ts",
    "gemini:models": "tsx scripts/gemini-models.ts",
    "package": "npm run export && tsx scripts/package.ts",
    "cache:clear": "node -e \"require('fs').rmSync('.cache/llm',{recursive:true,force:true});console.log('cache LLM vidé')\"",
    "wrangler": "npx -y -p node@22 node node_modules/wrangler/bin/wrangler.js",
    "worker:data": "tsx scripts/worker-data.ts",
    "worker:dev": "npm run worker:data && npm run wrangler -- dev --config worker/wrangler.toml",
    "worker:deploy": "npm run worker:data && npm run wrangler -- deploy --config worker/wrangler.toml",
    "precompute": "tsx scripts/precompute.ts",
    "repetition:charger": "tsx scripts/repetition.ts charger",
    "repetition:reset": "tsx scripts/repetition.ts reset",
    "verif": "tsx scripts/verif.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261003.1",
    "@types/node": "^26.6.4",
    "fflate": "^0.8.3",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "unpdf": "^1.8.1",
    "vite": "^6.4.3",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.147.0",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@google/genai": "^2.27.0",
    "jsonrepair": "^3.15.0",
    "minisearch": "^7.2.0"
  }
}
