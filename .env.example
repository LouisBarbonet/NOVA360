# Copier en .env. Un seul fournisseur suffit.

# Fournisseur du chat et de l'analyse d'impact : claude (défaut) ou gemini (secours, palier gratuit)
NOVA_PROVIDER=claude

# --- Claude (recommandé) : clé sur console.anthropic.com → API keys (crédits prépayés)
ANTHROPIC_API_KEY=
NOVA_MODEL=claude-haiku-4-5
NOVA_IMPACT_MODEL=claude-sonnet-5-5

# --- Gemini (secours gratuit) : clé sur aistudio.google.com → Get API key
# Quotas gratuits bas (quelques dizaines de requêtes/jour) ; « npm run gemini:models » liste les modèles disponibles
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_IMPACT_MODEL=gemini-flash-latest
# Modèle de repli si le principal est surchargé (503)
# Modèles de repli, dans l'ordre (le quota gratuit est compté par modèle : changer de modèle redonne du quota)
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-2.5-flash-lite,gemini-3.1-flash-lite
