# Copier en .env et renseigner la clé (console.anthropic.com → API keys)
ANTHROPIC_API_KEY=
# Modèle du chat (défaut : claude-haiku-4-5). Alternative plus nuancée : claude-sonnet-5-5
NOVA_MODEL=claude-haiku-4-5
# Modèle pour l'analyse d'impact d'un nouvel événement (défaut : NOVA_MODEL)
NOVA_IMPACT_MODEL=claude-sonnet-5-5
